# ─── Core ──────────────────────────────────────────────────────────────────────
# Any long random string. Makes room tokens permanent so bridges/phones never need
# re-pairing after a cloud restart. Generate: openssl rand -hex 32
RELAY_MASTER_SECRET=""

# APP_URL: public URL of this RAY hub (used for OAuth callbacks / OpenRouter referer).
APP_URL=""

# Durable storage for the Second Brain + room state. Set a GCS bucket on Google Cloud
# (Cloud Run uses its service account automatically). Empty = local .relay-data/ folder.
RAY_GCS_BUCKET=""
RAY_GCS_PREFIX="ray"
GCP_SERVICE_ACCOUNT_JSON=""   # needed for GCS when NOT on Google Cloud (e.g. Render)
RAY_CF_KV=""                  # "off" to stop using Cloudflare KV for storage
RAY_DAILY_TOKEN_CAP=""        # server-enforced daily token budget across all engines (0/empty = no cap)
RAY_KEEPALIVE=""              # "false" disables the 10-minute self-ping on Render

# Room that Meta webhooks (WhatsApp / Instagram) deliver into.
RAY_DEFAULT_ROOM="RLY-HOME"

# ─── Free AI engines (add any; RAY auto-routes & fails over between them) ─────
GEMINI_API_KEY=""           # https://aistudio.google.com/app/apikey (also enables Gemini Live voice)
GEMINI_LIVE_MODEL=""        # optional override for the Live voice model
GROQ_API_KEY=""             # https://console.groq.com/keys        (14.4K req/day)
CEREBRAS_API_KEY=""         # https://cloud.cerebras.ai             (14.4K req/day)
MISTRAL_API_KEY=""          # https://console.mistral.ai/api-keys   (1B tokens/month)
GITHUB_MODELS_TOKEN=""      # https://github.com/marketplace/models (GPT-4.1 etc.)
OPENROUTER_API_KEY=""       # https://openrouter.ai/keys            (:free models)
NVIDIA_API_KEY=""           # https://build.nvidia.com
SAMBANOVA_API_KEY=""        # https://cloud.sambanova.ai/apis
HUGGINGFACE_API_KEY=""      # https://huggingface.co/settings/tokens
COHERE_API_KEY=""           # https://dashboard.cohere.com/api-keys
OPENCODE_API_KEY=""         # oc_sk_…  OpenCode Zen (https://opencode.ai/zen) — free "big-pickle" model
OPENCODE_MODEL=""           # optional, default big-pickle
CLOUDFLARE_API_TOKEN=""     # cfut_…  Cloudflare token: Workers AI (+ KV storage if it has KV permission)
CLOUDFLARE_ACCOUNT_ID=""    # optional — discovered from the token automatically
LLM7_API_KEY=""             # optional — LLM7 works with no key at all
# Any OpenAI-compatible endpoint (LM Studio, vLLM, LocalAI…)
CUSTOM_LLM_BASE_URL=""
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_MODEL=""

# Local Ollama (reached through the PC bridge automatically when RAY runs in the cloud)
OLLAMA_HOST="http://127.0.0.1:11434"

# ─── Meta apps (official APIs; optional) ───────────────────────────────────────
WHATSAPP_TOKEN=""               # WhatsApp Cloud API (business number)
WHATSAPP_PHONE_NUMBER_ID=""
INSTAGRAM_ACCESS_TOKEN=""       # Instagram Messaging API (professional account)
INSTAGRAM_ACCOUNT_ID=""
META_VERIFY_TOKEN=""            # any string; webhook URL = <APP_URL>/api/meta/webhook
META_APP_SECRET=""              # required — unsigned webhook posts are rejected
RAY_AUTO_SEND_MESSAGES="false"  # true = skip the Approve tap when you explicitly say "send"

# ─── Web Push wake (optional — generated & stored automatically if empty) ─────
RAY_VAPID_PUBLIC_KEY=""
RAY_VAPID_PRIVATE_KEY=""
RAY_VAPID_SUBJECT="mailto:you@example.com"

# Optional local Obsidian vault folder mirrored by the bridge.
RELAY_VAULT_DIR=""
