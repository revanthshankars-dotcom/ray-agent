# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OLLAMA_HOST: Optional local Ollama server URL when running offline/hybrid inference.
OLLAMA_HOST="http://127.0.0.1:11434"

# OPENROUTER_API_KEY: Optional OpenRouter API key for routing across free/cloud OpenRouter models.
# Configure this in AI Studio Secrets or your local .env file.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GROQ_API_KEY: Optional Groq API key for high-speed free tier inference (llama-3.3-70b-versatile, etc.).
# Configure this in AI Studio Secrets or your local .env file.
GROQ_API_KEY="MY_GROQ_API_KEY"

# HUGGINGFACE_API_KEY: Optional Hugging Face free inference API token.
HUGGINGFACE_API_KEY="MY_HUGGINGFACE_API_KEY"

# RELAY_VAULT_DIR: Optional local folder path if syncing .md files via Desktop OS Bridge.
RELAY_VAULT_DIR=""
